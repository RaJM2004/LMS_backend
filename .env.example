# ==========================================
# LMS Backend Environment Variables
# Location: backend/.env
# ==========================================

# Server Configuration
PORT=5000

# MongoDB Database Connection
# Local MongoDB: mongodb://localhost:27017/dashboard
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dashboard?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/dashboard

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# AI Assessment & Chatbot (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here

# Email Services (Resend)
RESEND_API_KEY=your_resend_api_key_here
ADMIN_EMAIL=academy@genquantaa.com

# Cashfree Payment Gateway (Optional / If testing payments)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST
